{
  "name": "@flowscripter/example-plugin",
  "version": "1.3.29",
  "description": "Example plugin for the https://github.com/flowscripter/dynamic-plugin-framework",
  "keywords": [
    "bun",
    "dynamic",
    "example",
    "framework",
    "import",
    "plugin"
  ],
  "homepage": "https://github.com/flowscripter/example-plugin#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowscripter/example-plugin.git"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "module": "dist/bundle.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/bundle.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build index.ts --outdir ./dist --entry-naming bundle.js --minify --external \"@flowscripter/dynamic-plugin-framework\" && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@flowscripter/example-plugin-api": "^1.3.23"
  },
  "devDependencies": {
    "@flowscripter/dynamic-plugin-framework": "^2.2.23",
    "@types/bun": "^1.4.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0"
  },
  "peerDependencies": {
    "@flowscripter/dynamic-plugin-framework": "*",
    "typescript": "^7.0.2"
  },
  "typedocOptions": {
    "readme": "none",
    "exclude": [
      "tests/**"
    ]
  }
}
