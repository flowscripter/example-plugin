{
  "name": "@flowscripter/example-plugin",
  "version": "1.3.19",
  "description": "Example plugin for the https://github.com/flowscripter/dynamic-plugin-framework",
  "keywords": [
    "bun",
    "dynamic",
    "example",
    "framework",
    "import",
    "plugin"
  ],
  "homepage": "https://github.com/flowscripter/example-plugin#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowscripter/example-plugin.git"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "module": "dist/bundle.js",
  "exports": "./dist/bundle.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build index.ts --outdir ./dist --entry-naming bundle.js --minify --external \"@flowscripter/dynamic-plugin-framework\""
  },
  "dependencies": {
    "@flowscripter/example-plugin-api": "^1.3.12"
  },
  "devDependencies": {
    "@flowscripter/dynamic-plugin-framework": "^2.2.7",
    "@types/bun": "^1.4.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0"
  },
  "peerDependencies": {
    "@flowscripter/dynamic-plugin-framework": "*",
    "typescript": "^7.0.2"
  },
  "typedocOptions": {
    "readme": "none",
    "exclude": [
      "tests/**"
    ]
  }
}
